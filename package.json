{
  "name": "reelch",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.22.3" },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "test": "npm run test:backend",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e && npm --prefix frontend run test:e2e",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed-admin": "npm --prefix backend run db:seed-admin",
    "check": "npm run lint && npm run test && npm run build"
  }
}
