NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://reelch:reelch_local_password@localhost:5432/reelch
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
CONVERSION_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Cloudflare R2 private upload bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=reelch-verification-documents

# Paystack campaign funding. Use sk_test_... until production approval.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:3000/business/wallet
