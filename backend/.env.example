NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://reelch:reelch_local_password@localhost:5432/reelch
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=5000
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
# Budget total connections across API + workers + migration/admin headroom.
SERVICE_NAME=reelch-api
# Leave empty for direct connections. Set only hosting-provider proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
PASSWORD_CONCURRENCY=4
PASSWORD_QUEUE_MAX=64
PASSWORD_QUEUE_TIMEOUT_MS=5000
# Configure before Node starts; coordinate with PASSWORD_CONCURRENCY and CPU capacity.
UV_THREADPOOL_SIZE=4
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_IP_MAX=120
RATE_LIMIT_LOGIN_ACCOUNT_MAX=20
RATE_LIMIT_REGISTER_IP_MAX=120
RATE_LIMIT_REGISTER_ACCOUNT_MAX=5
RATE_LIMIT_WAITLIST_IP_MAX=120
RATE_LIMIT_CONTACT_IP_MAX=30
RATE_LIMIT_INVITE_IP_MAX=30
# Run db:migrate and jobs:provision, then deploy workers before enabling producers.
JOBS_ENABLED=false
WORKER_CONCURRENCY=4
PAYMENT_WORKER_CONCURRENCY=2
WORKER_PORT=4001
# Dockerfile.worker disables HTTP for the private Vercel daemon.
WORKER_HTTP_ENABLED=true
JWT_SECRET=replace-with-at-least-32-random-characters
CONVERSION_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Transactional email: verify your sending domain in Resend before enabling.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Reelch <hello@your-verified-domain.com>
# Optional mailbox that receives user replies.
EMAIL_REPLY_TO=
EMAIL_WORKER_CONCURRENCY=1

# Cloudflare R2 private upload bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=reelch-verification-documents

# Payment rail for new campaigns: paypal (USD by default) or paystack (NGN).
# Existing NGN campaigns keep using Paystack because PayPal cannot settle NGN.
PAYMENT_PROVIDER=paypal
# PayPal REST app from developer.paypal.com. Use sandbox credentials for the hackathon.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Webhook ID from the PayPal app's webhook settings; webhooks are rejected until it is set.
PAYPAL_WEBHOOK_ID=
# Send promoter earnings to their PayPal email as soon as a proof is approved.
PAYPAL_AUTO_PAYOUT=true
# Smallest manual withdrawal, in cents.
PAYPAL_MIN_PAYOUT_MINOR=100

# AI proof verification. Any provider/model can be swapped in here without code changes.
# AI_PROVIDER: gemini | openai-compatible (OpenAI, OpenRouter, Groq, ... via AI_BASE_URL)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
# Optional: override the provider endpoint, e.g. https://openrouter.ai/api/v1
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_WORKER_CONCURRENCY=2
# Policy for paying without a human: every check must pass and the score must reach this minimum.
AI_AUTO_APPROVE=true
AI_AUTO_APPROVE_MIN_SCORE=85
# Screenshot-only proofs (e.g. WhatsApp Status) cannot prove views; keep false outside demos.
AI_AUTO_APPROVE_EVIDENCE_ONLY=false

# Paystack campaign funding. Use sk_test_... until production approval.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:3000/business/wallet
# Optional live-mode DVA provider (for example titan-paystack). Test keys always use test-bank.
PAYSTACK_DVA_BANK=titan-paystack

# Social verification APIs. Leave blank to route submissions to manual review.
X_BEARER_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
